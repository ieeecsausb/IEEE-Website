# ============================================================
#  IEEE CS Website — repo ignore rules
#  Patterns without a leading slash match at ANY depth, so
#  `node_modules/` covers backend/, frontend/ and nested copies.
# ============================================================

# ---------- Dependencies ----------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js
jspm_packages/

# ---------- Build output ----------
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
serviceAccountKey.json

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Caches ----------
.npm/
.eslintcache
.cache/
.parcel-cache/
.turbo/
*.tgz

# ---------- Test coverage ----------
coverage/
*.lcov
.nyc_output/

# ---------- Local database dumps / uploads ----------
data/
dump/
uploads/
*.sqlite
*.sqlite3

# ---------- Editors & IDEs ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# ---------- OS cruft ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- Deploy platforms ----------
.vercel
.netlify
